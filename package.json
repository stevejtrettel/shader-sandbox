{
  "name": "shader-sandbox",
  "version": "0.3.0",
  "description": "Local Shadertoy-compatible GLSL shader development environment with live editing",
  "author": "Steve Trettel",
  "license": "MIT",
  "homepage": "https://github.com/stevejtrettel/shader-sandbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevejtrettel/shader-sandbox.git"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "shader",
    "glsl",
    "shadertoy",
    "webgl",
    "graphics",
    "creative-coding"
  ],
  "type": "module",
  "main": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "node": "./dist-lib/node.js",
      "import": "./dist-lib/index.js",
      "default": "./dist-lib/index.js"
    },
    "./node": {
      "types": "./dist-lib/node.d.ts",
      "import": "./dist-lib/node.js",
      "default": "./dist-lib/node.js"
    },
    "./runtime": {
      "types": "./dist-lib/runtime.d.ts",
      "import": "./dist-lib/runtime.js",
      "default": "./dist-lib/runtime.js"
    },
    "./runtime/standalone": {
      "types": "./dist-lib/runtime.d.ts",
      "import": "./dist-runtime/shader-sandbox.js",
      "default": "./dist-runtime/shader-sandbox.js"
    }
  },
  "bin": {
    "shader": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist-lib",
    "dist-runtime",
    "templates"
  ],
  "scripts": {
    "new": "node scripts/new-demo.cjs",
    "predev": "node scripts/generate-loader.cjs",
    "dev": "vite",
    "dev:demo": "node scripts/dev-demo.cjs",
    "prebuild": "node scripts/generate-loader.cjs",
    "build": "tsc && vite build",
    "build:lib": "node scripts/build-lib.cjs",
    "build:runtime": "vite build --config vite.config.runtime.ts",
    "prepublishOnly": "npm run build:lib && npm run build:runtime",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mediabunny": "^1.40.1",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/prismjs": "^1.26.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0"
  }
}
