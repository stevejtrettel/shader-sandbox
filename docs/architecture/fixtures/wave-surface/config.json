{
  "schema": 1,
  "title": "Wave equation: membrane and colormap",

  "resources": {
    "wave": { "kind": "field", "format": "rg32f", "size": [512, 512], "init": "init.glsl" }
  },

  "uniforms": {
    "uWaveSpeed":   { "value": 0.6,  "min": 0.1, "max": 1.0,  "label": "Wave speed" },
    "uDamping":     { "value": 0.001,"min": 0.0, "max": 0.01, "label": "Damping" },
    "uPokeRadius":  { "value": 0.03, "min": 0.01,"max": 0.1,  "label": "Poke size" },
    "uHeightScale": { "value": 0.35, "min": 0.0, "max": 1.0,  "label": "Relief" }
  },

  "controllers": {
    "poke":   { "type": "drag",  "outputs": { "uPokePos": "position", "uPokeOn": "active" } },
    "camera": { "type": "orbit", "target": [0, 0, 0], "radius": 2.5,
                "outputs": { "uViewProj": "viewProjection", "uEye": "position" } }
  },

  "passes": {
    "step":    { "shader": "step.glsl", "reads": { "wave": "wave" }, "writes": "wave" },

    "flat":    { "shader": "flat.glsl", "reads": { "wave": "wave" } },
    "surface": { "vertex": "surface.vert.glsl", "fragment": "surface.frag.glsl",
                 "domain": { "mesh": "grid", "subdivisions": [256, 256] },
                 "reads": { "wave": "wave" },
                 "state": { "depth": true } }
  },

  "options": { "stepsPerFrame": 4 },

  "views": {
    "flat":    { "pass": "flat",    "controller": "poke" },
    "surface": { "pass": "surface", "controller": "camera" }
  }
}
